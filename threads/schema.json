{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conversation thread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "source",
    "posts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation",
        "article"
      ],
      "properties": {
        "conversation": {
          "type": "string",
          "minLength": 1
        },
        "article": {
          "type": "string",
          "minLength": 1
        },
        "article_url": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "posts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
